{
  "name": "@nodecfdi/credentials",
  "type": "module",
  "version": "3.2.0",
  "packageManager": "pnpm@12.21.0",
  "description": "Librería para usar eFirma (fiel) y CSD (sellos) para el SAT",
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "author": "Fernando Isidro <luffynando@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/nodecfdi/credentials",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodecfdi/credentials.git"
  },
  "bugs": {
    "url": "https://github.com/nodecfdi/credentials/issues"
  },
  "keywords": [
    "certificate",
    "sat",
    "csd",
    "fiel",
    "signing",
    "firmar",
    "factura",
    "rfc",
    "efirma",
    "sellos",
    "pfx"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.13.0 || ^24 || ^26"
  },
  "scripts": {
    "prepare": "is-in-ci || husky",
    "changelog": "auto-changelog -u -p",
    "commitlint": "commitlint --edit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tool:code": "pnpm run lint:check && pnpm run typecheck",
    "tool:build": "pnpm run tool:code && pnpm run test:run",
    "build": "tsdown",
    "release": "release-it"
  },
  "peerDependencies": {
    "@types/luxon": "3.7.6",
    "luxon": "^3.7.2"
  },
  "peerDependenciesMeta": {
    "@types/luxon": {
      "optional": true
    }
  },
  "dependencies": {
    "@nodecfdi/base-converter": "^3.0.1",
    "@types/node-forge": "^1.3.14",
    "node-forge": "^1.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eienjs/eslint-config": "^2.3.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.0",
    "auto-changelog": "^2.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "husky": "^9.1.7",
    "is-in-ci": "^2.0.0",
    "release-it": "^21.1.2",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vitest-mock-extended": "^6.0.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "auto-changelog": {
    "template": "keepachangelog",
    "hideCredit": true,
    "commitLimit": false
  },
  "release-it": {
    "git": {
      "commit": true,
      "tag": true,
      "push": true,
      "requireCleanWorkingDir": true,
      "commitMessage": "chore(release): :tada: v${version}",
      "tagAnnotation": "chore(release): :tada: v${version}"
    },
    "github": {
      "release": true,
      "web": true,
      "releaseName": "Release v${version}"
    },
    "npm": {
      "publish": true,
      "publishPackageManager": "pnpm",
      "publishArgs": [
        "--no-git-checks"
      ]
    },
    "hooks": {
      "before:init": [
        "pnpm run lint:check",
        "pnpm run typecheck",
        "pnpm test:run"
      ],
      "after:bump": [
        "pnpm run build",
        "pnpm run changelog"
      ]
    }
  }
}
